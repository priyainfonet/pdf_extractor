# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---------------------------------------------------------
# SQLite for local dev (default, zero setup):
DATABASE_URL=sqlite:///./storage/app.db
# PostgreSQL later, once installed (pip install psycopg2-binary first):
# DATABASE_URL=postgresql://user:password@localhost:5432/pdfkit

# --- Auth ---------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Email (password reset) ------------------------------------------------
# Leave SMTP_HOST empty for local dev — reset emails get logged instead of
# sent, so you can see the reset link directly in the server's console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Where your FRONTEND's reset-password page lives — the emailed link
# points here with a ?token=... appended.
FRONTEND_URL=http://127.0.0.1:5500/html/forgot-password.html

# --- Retention / cleanup ---------------------------------------------------
FILE_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# --- Storage --------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=./storage
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# --- Background jobs -------------------------------------------------------
JOB_QUEUE_TYPE=inprocess
# REDIS_URL=redis://localhost:6379/0

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=*

# --- Misc ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
ENVIRONMENT=development
